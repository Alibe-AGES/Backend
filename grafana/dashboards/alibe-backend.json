      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      },
      "pluginVersion": "13.2.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * ((sum(rate(http_errors_total{instance=~\".+:3000\", route!~\"/health.*|/metrics.*\"}[$__rate_interval])) or vector(0)) / clamp_min((sum(rate(http_requests_total{instance=~\".+:3000\", route!~\"/health.*|/metrics.*\"}[$__rate_interval])) or vector(0)), 0.000001))",
          "instant": false,
          "legendFormat": "Error rate",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "HTTP error rate over time",
      "type": "timeseries"
