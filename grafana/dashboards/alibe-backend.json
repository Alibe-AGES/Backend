      "description": "Requisições recebidas pela API no período selecionado (canto superior direito), sem health checks e sem a coleta do Prometheus.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
