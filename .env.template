# DESENVOLVIMENTO LOCAL APENAS.
# Este arquivo configura Docker Compose, PostgreSQL local e MiniStack.
# Nao copie estas variaveis diretamente para a EC2.

DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=alibe
APP_PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/alibe
SEED_ON_STARTUP=false
BETTER_AUTH_SECRET=dev-only-alibe-secret-2026-change-before-production
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=alibe://,alibe://*,http://localhost:8081,exp://,exp://**
AWS_REGION=us-east-2
AWS_S3_BUCKET=alibe-local-media
AWS_SQS_NOTIFICATION_QUEUE_URL=http://ministack:4566/000000000000/alibe-local-notifications
AWS_ENDPOINT_URL=http://ministack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
ENABLE_NOTIFICATION_TEST_ENDPOINT=true
GOOGLE_PLACES_API_KEY=
