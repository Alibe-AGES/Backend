# PRODUCAO AWS: variaveis da EC2. Copie para infra/prod/.env.production e preencha os CHANGE_ME.
# Este arquivo real e ignorado pelo Git e nunca deve ser commitado. Sem aspas nos valores.
#
# Nao defina AWS_ENDPOINT_URL, AWS_ACCESS_KEY_ID nem AWS_SECRET_ACCESS_KEY: a API usa a IAM Role
# da EC2. Nao copie DATABASE_USER/PASSWORD/NAME, APP_PORT, SEED_ON_STARTUP ou MOCK_AUTH_* do .env local.

# --- API -------------------------------------------------------------------------------------
# Senha so com letras e numeros (ou codificada para URL). uselibpqcompat=true e necessario para o
# driver pg aceitar o certificado do RDS mantendo a conexao criptografada.
DATABASE_URL=postgresql://alibe_admin:CHANGE_ME_PASSWORD@CHANGE_ME_RDS_ENDPOINT:5432/alibe?schema=public&sslmode=require&uselibpqcompat=true
PORT=3000

# Texto aleatorio com pelo menos 32 caracteres (ex.: openssl rand -hex 32).
BETTER_AUTH_SECRET=CHANGE_ME
# Endereco publico da API.
BETTER_AUTH_URL=http://CHANGE_ME_ELASTIC_IP
BETTER_AUTH_TRUSTED_ORIGINS=alibe://,alibe://*,exp://,exp://**
# Cliente OAuth do tipo "Aplicativo da Web" no Google Cloud. Deixe ambos vazios para desativar o
# login com Google. O Google exige HTTPS e dominio (nao aceita IP) no redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AWS_REGION=us-east-2
AWS_S3_BUCKET=alibe-prod-media
AWS_SQS_NOTIFICATION_QUEUE_URL=CHANGE_ME_NOTIFICATION_QUEUE_URL

GOOGLE_PLACES_API_KEY=CHANGE_ME

# Rotas de teste de notificacao. true somente durante um teste, depois volte para false.
ENABLE_NOTIFICATION_TEST_ENDPOINT=false

# --- Grafana (usuario admin) -----------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
