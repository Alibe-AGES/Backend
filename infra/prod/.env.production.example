# PRODUCAO AWS: variaveis do container da API na EC2.
# Copie este arquivo para infra/prod/.env.production e preencha os CHANGE_ME.
# O arquivo .env.production real e ignorado pelo Git e nunca deve ser commitado.
#
# Use somente as variaveis declaradas abaixo. Nao copie DATABASE_USER,
# DATABASE_PASSWORD, DATABASE_NAME, APP_PORT ou SEED_ON_STARTUP do ambiente local.
# Nao defina AWS_ENDPOINT_URL, AWS_ACCESS_KEY_ID ou AWS_SECRET_ACCESS_KEY na EC2.

# O Backend e o Prisma utilizam somente esta URL para acessar o RDS privado.
# Obtenha o endpoint na stack 02-data.yml e codifique para URL os caracteres especiais da senha.
DATABASE_URL=postgresql://alibe_admin:CHANGE_ME_URL_ENCODED_PASSWORD@CHANGE_ME_RDS_ENDPOINT:5432/alibe?schema=public&sslmode=require

# Porta interna do NestJS. A porta publica 80 e mapeada pelo Docker Compose.
PORT=3000

# Gere um segredo aleatorio com pelo menos 32 caracteres. Nunca reutilize o valor local.
BETTER_AUTH_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Durante o teste inicial, use o Elastic IP da EC2. Depois substitua pelo dominio HTTPS.
BETTER_AUTH_URL=http://CHANGE_ME_EC2_ELASTIC_IP

# Origens aceitas pelo Better Auth. Mantenha somente os schemes e dominios usados pelo app.
BETTER_AUTH_TRUSTED_ORIGINS=alibe://,alibe://*

# Na AWS real nao configure AWS_ENDPOINT_URL nem credenciais estaticas.
# O SDK obtem credenciais temporarias pela IAM Role associada a EC2.
AWS_REGION=us-east-2

# Nome exato do bucket criado pela stack 02-data.yml.
AWS_S3_BUCKET=alibe-prod-media

# URL exportada como NotificationQueueUrl pela stack 03-services.yml.
AWS_SQS_NOTIFICATION_QUEUE_URL=CHANGE_ME_NOTIFICATION_QUEUE_URL

# Nunca habilite a rota de notificacao sintetica no ambiente publico.
ENABLE_NOTIFICATION_TEST_ENDPOINT=false
